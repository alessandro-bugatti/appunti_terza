<?xml version="1.0"?>
<flowgorithm fileversion="4.2">
    <attributes>
        <attribute name="name" value="fibonacci"/>
        <attribute name="authors" value="alex"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2026-10-07 01:17:33 PM"/>
        <attribute name="created" value="YWxleDtDQUxWSU47MjAyNi0xMC0wNzsxMjo0MTowNiBQTTsyMTQ3"/>
        <attribute name="edited" value="YWxleDtDQUxWSU47MjAyNi0xMC0wNzswMToxNzozMyBQTTsxOzIyNTY="/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="fib, n1, n2, N, i" type="Integer" array="False" size=""/>
            <assign variable="n1" expression="1"/>
            <assign variable="n2" expression="0"/>
            <input variable="N"/>
            <for variable="i" start="2" end="N" direction="inc" step="1">
                <assign variable="fib" expression="n1 + n2"/>
                <assign variable="n2" expression="n1"/>
                <assign variable="n1" expression="fib"/>
            </for>
            <output expression="fib" newline="True"/>
        </body>
    </function>
</flowgorithm>
